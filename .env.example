# ==============================================================================
# MY-USERSCRIPTS GLOBAL DEV CONSTANTS & PATHS (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local for local overrides.
# NEVER commit .env or .env.local containing personal tokens or private data.
# ==============================================================================

# --- REPO & GITHUB CONFIG ---
GITHUB_USER="pallax03"
GITHUB_REPO="my-userscripts"
GITHUB_BRANCH="master"
GITHUB_RAW_BASE="https://raw.githubusercontent.com/${GITHUB_USER}/${GITHUB_REPO}/${GITHUB_BRANCH}"
GITHUB_REPO_URL="https://github.com/${GITHUB_USER}/${GITHUB_REPO}"

# --- LOCAL PATHS (macOS) ---
# Optional custom path for Safari Userscripts iCloud folder.
SAFARI_USERSCRIPTS_ICLOUD_DIR="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/Userscripts"

# --- USERSCRIPTS METADATA & RAW URLS ---
# 1. AnimeUnity to AniList Sync
SCRIPT_SYNC_FILE="dist/sync-anilist.user.js"
SCRIPT_SYNC_RAW="${GITHUB_RAW_BASE}/${SCRIPT_SYNC_FILE}"

# 2. AniList Friend List Quick Add & Sync
SCRIPT_IMPORT_FILE="dist/import-friend-anilist.user.js"
SCRIPT_IMPORT_RAW="${GITHUB_RAW_BASE}/${SCRIPT_IMPORT_FILE}"

# --- THIRD-PARTY APIS & OAUTH ---
ANILIST_API_URL="https://graphql.anilist.co"
ANILIST_CLIENT_ID="43750"
ANILIST_OAUTH_URL="https://anilist.co/api/v2/oauth/authorize?client_id=${ANILIST_CLIENT_ID}&response_type=token"

# --- RECOMMENDED BROWSER EXTENSIONS ---
SAFARI_USERSCRIPTS_STORE="https://apps.apple.com/app/userscripts/id1463298887"
CHROME_TAMPERMONKEY_STORE="https://chromewebstore.google.com/detail/tampermonkey/dhdgffkkebhmkfjojejmpbldmpobfkfo"
